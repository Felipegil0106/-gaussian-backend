# === Variables de entorno para el Backend ===
# Copia este archivo como .env y rellena con tus valores

# RunPod
RUNPOD_API_KEY=rpa_TU_API_KEY_AQUI
RUNPOD_ENDPOINT_ID=TU_ENDPOINT_ID_AQUI

# Cloudflare R2
R2_ACCOUNT_ID=TU_ACCOUNT_ID_AQUI
R2_ACCESS_KEY=TU_ACCESS_KEY_AQUI
R2_SECRET_KEY=TU_SECRET_KEY_AQUI
R2_BUCKET=gaussian-scanner

# Backend
BACKEND_URL=https://TU_APP.railway.app
PORT=8000
DB_PATH=/data/jobs.db
